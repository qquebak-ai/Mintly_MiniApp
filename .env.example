# Скопируй в .env и подставь свои значения.
# Всё с префиксом VITE_ попадает в браузер — секретов здесь быть не должно.

VITE_SUPABASE_URL=https://<проект>.supabase.co
VITE_SUPABASE_ANON_KEY=<публичный anon-ключ проекта>

# Имя основного бота — из него собираются ссылки приглашения и карточек токенов.
VITE_TG_BOT=MintlyCobot

# Серверные переменные (Vercel → Project Settings → Environment Variables),
# в этот файл их класть нельзя:
#   TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET,
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET,
#   APP_URL          — адрес приложения для кнопок в сообщениях бота
#   SUPPORT_CHAT_ID  — чат команды, куда бот носит вопросы поддержки.
#                      Как узнать: добавить бота в группу, сделать его
#                      администратором и отправить там «/id».

# Ключ tonapi (https://tonconsole.com). Без него сервис пускает считанные
# запросы в минуту на адрес: при открытии приложения пачка обращений —
# состояние кривой, свечи, метаданные, балансы — упирается в 429, и цена
# с графиком просто не приезжают. Ключ публичный по природе (виден в
# коде страницы), но лимит поднимает на порядок.
VITE_TONAPI_KEY=
